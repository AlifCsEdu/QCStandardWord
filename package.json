{
  "name": "qc-standard-wording",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy ./dist --project-name=qc-standard-wording",
    "deploy:pages": "wrangler pages deploy ./dist --project-name=qc-standard-wording",
    "test": "node --test tests/**/*.test.js",
    "test:tier1": "node --test tests/tier1-features.test.js",
    "test:tier2": "node --test tests/tier2-boundary.test.js",
    "test:tier3": "node --test tests/tier3-combinations.test.js",
    "test:tier4": "node --test tests/tier4-workloads.test.js"
  },
  "dependencies": {
    "@mantine/core": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "@mantine/notifications": "^7.15.0",
    "@mantine/spotlight": "^7.15.0",
    "@tabler/icons-react": "^3.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
